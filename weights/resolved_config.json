{
  "data": {
    "batch_size": 256,
    "num_workers": 4
  },
  "model": {
    "obs_embed_dim": 256,
    "static_embed_dim": 256,
    "action_embed_dim": 64,
    "categorical_embed_dim": 16,
    "hidden_dim": 256,
    "transformer_layers": 4,
    "transformer_heads": 8,
    "transformer_ff_dim": 1024,
    "transformer_dropout": 0.1,
    "max_seq_len": 16,
    "predictor_layers": 3
  },
  "world_loss": {
    "jepa_loss_scale": 1.5,
    "jepa_loss": "mse",
    "variance_loss_scale": 0.06,
    "embedding_variance_floor": 0.5,
    "reward_binary_loss_scale": 1,
    "reward_binary_event_scales": {
      "death_event": 2.0
    },
    "binary_reward_pos_weight_max": 10.0,
    "multi_horizon": 3,
    "multi_horizon_weights": [
      1,
      1,
      1
    ],
    "multi_horizon_clinical": true,
    "multi_horizon_clinical_scale": 1
  },
  "training": {
    "seed": 2026,
    "world_epochs": 40,
    "world_lr": 3e-05,
    "weight_decay": 0.0005,
    "grad_clip": 5.0,
    "world_eval_every": 2,
    "early_stopping_patience": 6,
    "early_stopping_min_delta": 0.001,
    "early_stopping_metric": "jepa_clinical_weighted",
    "early_stopping_jepa_weight": 1.0,
    "early_stopping_clinical_weight": 1.0,
    "rare_event_reward_names": [
      "death_event"
    ],
    "calibrate_binary_thresholds": true,
    "binary_threshold_grid_size": 99,
    "target_encoder_tau": 0.05
  }
}